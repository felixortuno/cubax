{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cubax.es" }],
      "destination": "https://cubax.es/:path",
      "permanent": true
    },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/desatascos-castellon.php", "destination": "/", "permanent": true },
    { "source": "/desatascos-para-aseguradoras-con-clientes-en-castellon.php", "destination": "/", "permanent": true },
    { "source": "/desatascos-para-ayuntamientos-en-castellon.php", "destination": "/", "permanent": true },
    { "source": "/desatascos-para-administradores-de-fincas-en-castellon.php", "destination": "/", "permanent": true },
    { "source": "/aviso-legal.php", "destination": "/aviso-legal", "permanent": true },
    { "source": "/politica-privacidad.php", "destination": "/politica-privacidad", "permanent": true },
    { "source": "/cookies.php", "destination": "/cookies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(img|favicon|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
